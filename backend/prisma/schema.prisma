// DRO Cargas PRO — Schema de banco de dados
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
  COMERCIAL
  MOTORISTA
  CLIENTE
}

enum CargaStatus {
  DISPONIVEL
  EM_TRANSITO
  ENCERRADA
  SUSPENSA
  CANCELADA
}

enum TipoDocumento {
  FOTO
  PDF
  XML
  CTE
  MDFE
  OUTRO
}

enum TipoTransacao {
  RECEITA
  DESPESA
  COMISSAO
}

model User {
  id                String    @id @default(uuid())
  nome              String
  email             String    @unique
  senhaHash         String    @map("senha_hash")
  role              Role
  fotoUrl           String?   @map("foto_url")
  ativo             Boolean   @default(true)
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret")
  ultimoAcesso      DateTime? @map("ultimo_acesso")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @default(now()) @map("atualizado_em")

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  motorista         Motorista?
  cliente           Cliente?
  cargasCriadas     Carga[]        @relation("CargaCriadaPor")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEm   DateTime @map("expira_em")
  revogado   Boolean  @default(false)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique @map("token_hash")
  expiraEm  DateTime @map("expira_em")
  usado     Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  acao       String
  entidade   String
  entidadeId String?  @map("entidade_id")
  detalhes   Json?
  ip         String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

model Carga {
  id              String      @id @default(uuid())
  codigo          String      @unique
  origemCidade    String      @map("origem_cidade")
  origemUf        String      @map("origem_uf")
  destinoCidade   String      @map("destino_cidade")
  destinoUf       String      @map("destino_uf")
  produto         String
  peso            Decimal?    @db.Decimal(10, 2)
  valor           Decimal     @db.Decimal(12, 2)
  status          CargaStatus @default(DISPONIVEL)
  observacoes     String?
  dataColeta      DateTime?   @map("data_coleta")
  dataEntrega     DateTime?   @map("data_entrega")

  clienteId       String?     @map("cliente_id")
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])
  motoristaId     String?     @map("motorista_id")
  motorista       Motorista?  @relation(fields: [motoristaId], references: [id])
  veiculoId       String?     @map("veiculo_id")
  veiculo         Veiculo?    @relation(fields: [veiculoId], references: [id])

  criadoPorId     String      @map("criado_por_id")
  criadoPor       User        @relation("CargaCriadaPor", fields: [criadoPorId], references: [id])

  documentos      Documento[]
  historico       CargaHistorico[]

  criadoEm        DateTime    @default(now()) @map("criado_em")
  atualizadoEm    DateTime    @default(now()) @map("atualizado_em")

  @@index([status])
  @@index([clienteId])
  @@index([motoristaId])
  @@map("cargas")
}

model CargaHistorico {
  id        String   @id @default(uuid())
  cargaId   String   @map("carga_id")
  carga     Carga    @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  statusDe  CargaStatus? @map("status_de")
  statusPara CargaStatus @map("status_para")
  observacao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("carga_historico")
}

model Documento {
  id        String        @id @default(uuid())
  cargaId   String        @map("carga_id")
  carga     Carga         @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  tipo      TipoDocumento
  nomeArquivo String      @map("nome_arquivo")
  url       String
  criadoEm  DateTime      @default(now()) @map("criado_em")

  @@map("documentos")
}

model Motorista {
  id            String   @id @default(uuid())
  userId        String?  @unique @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])
  nome          String
  cnh           String
  cnhCategoria  String   @map("cnh_categoria")
  cnhValidade   DateTime @map("cnh_validade")
  telefone      String?
  disponivel    Boolean  @default(true)
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  avaliacaoMedia Decimal @default(0) @db.Decimal(3, 2) @map("avaliacao_media")

  cargas        Carga[]
  veiculos      Veiculo[]

  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @default(now()) @map("atualizado_em")

  @@map("motoristas")
}

model Veiculo {
  id              String   @id @default(uuid())
  placa           String   @unique
  tipo            String
  motoristaId     String?  @map("motorista_id")
  motorista       Motorista? @relation(fields: [motoristaId], references: [id])
  seguroValidade  DateTime? @map("seguro_validade")
  licenciamentoValidade DateTime? @map("licenciamento_validade")
  quilometragem   Int?      @default(0)

  cargas          Carga[]

  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @default(now()) @map("atualizado_em")

  @@map("veiculos")
}

model Cliente {
  id           String   @id @default(uuid())
  userId       String?  @unique @map("user_id")
  user         User?    @relation(fields: [userId], references: [id])
  razaoSocial  String   @map("razao_social")
  cnpjCpf      String   @unique @map("cnpj_cpf")
  email        String?
  telefone     String?
  cidade       String?
  uf           String?

  cargas       Carga[]
  propostas    Proposta[]

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @map("atualizado_em")

  @@map("clientes")
}

model Proposta {
  id         String   @id @default(uuid())
  clienteId  String   @map("cliente_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  descricao  String
  valor      Decimal  @db.Decimal(12, 2)
  status     String   @default("aberta")
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("propostas")
}

model Transacao {
  id          String        @id @default(uuid())
  tipo        TipoTransacao
  descricao   String
  valor       Decimal       @db.Decimal(12, 2)
  cargaId     String?       @map("carga_id")
  categoria   String?
  dataPagamento DateTime?   @map("data_pagamento")
  criadoEm    DateTime      @default(now()) @map("criado_em")

  @@index([tipo])
  @@map("transacoes")
}
